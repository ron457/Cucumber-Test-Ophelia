{
  "name": "ophelia",
  "version": "1.0.0",
  "description": "Playwright Cucumber TypeScript automation framework",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "clean:reports": "rmdir /s /q reports\\html-report 2>nul & rmdir /s /q reports\\screenshots 2>nul & rmdir /s /q reports\\videos 2>nul & del /q reports\\cucumber-report.json 2>nul",

    "test": "cucumber-js",

    "test:smoke": "cucumber-js --tags \"@smoke\"",
    "test:login": "cucumber-js --tags \"@login\"",
    "test:register": "cucumber-js --tags \"@register\"",
    "test:cart": "cucumber-js --tags \"@cart\"",
    "test:checkout": "cucumber-js --tags \"@checkout\"",
    "test:checkout-guest": "cucumber-js --tags \"@checkout-guest\"",
    "test:search": "cucumber-js --tags \"@search\"",
    "test:sort": "cucumber-js --tags \"@sort\"",
    "test:comparison": "cucumber-js --tags \"@comparison\"",
    "test:regression": "cucumber-js --tags \"@regression\"",
    

    "report": "ts-node report.ts",

    "test:demo": "cucumber-js --tags \"@checkout-guest or @search or @sort or @comparison\"",
    "test:demo:report": "npm run clean:reports && npm run test:demo && npm run report",

    "test:full-report": "npm run clean:reports && npm run test && npm run report",

    "test:regression:report": "npm run clean:reports && npm run test:regression && npm run report"
  },

  "devDependencies": {
    "@cucumber/cucumber": "^10.9.0",
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.15.21",
    "multiple-cucumber-html-reporter": "^3.10.0",
    "playwright": "^1.60.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}